# Copy this file to .env and fill in your values.
# NEVER commit .env — it is already git-ignored.

# Required: Groq API key (free tier, no credit card) — get one at https://console.groq.com/keys
GROQ_API_KEY=gsk-your-key-here

# Optional overrides — defaults shown below
# ASR_MODEL=base                    # faster-whisper size: tiny, base, small, medium, large-v3
# SUMMARY_MODEL=llama-3.1-8b-instant
